<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pointblue.console</groupId>
    <artifactId>directory-console</artifactId>
    <version>0.3.19</version>
    <packaging>pom</packaging>
    <name>Directory Console</name>
    <description>An eDirectory and Identity Manager console built on the DirXMLDev core
       . Libraries here are shared with DirXMLDevWeb.</description>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <modules>
        <module>console-auth</module>
        <module>console-server</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The DirXMLDev release these modules build on (its Json helper today, its DN library
             next). Install it with `mvn -o install -DskipTests` in the DirXMLDev checkout. -->
        <dirxmldev.version>0.52.0</dirxmldev.version>
        <simulator.version>1.7.0</simulator.version>
        <bouncycastle.version>1.80</bouncycastle.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Point Blue's policy simulator: DirXMLDev's Operate parses XDS with it (driver health, queries);
                 only com.pointblue classes, shipped in the image like DirXMLDevWeb's; from its GitHub release -->
            <dependency>
                <groupId>com.pointblue.dirxml</groupId>
                <artifactId>dirxml-simulator</artifactId>
                <version>${simulator.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>*</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>com.pointblue.dirxml</groupId>
                <artifactId>dirxml-dev</artifactId>
                <version>${dirxmldev.version}</version>
                <!-- only DirXMLDev's own classes: its engine and simulator dependencies are
                     not needed by these libraries and are not on Maven Central -->
                <exclusions>
                    <exclusion>
                        <groupId>*</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <!-- the LDAP library DirXMLDev sends Identity Manager's extended operations with (open source,
                 OpenLDAP Public License; on Maven Central): no engine jars are needed since DirXMLDev 0.37.0 -->
            <dependency>
                <groupId>com.novell.ldap</groupId>
                <artifactId>jldap</artifactId>
                <version>4.3</version>
            </dependency>
            <dependency>
                <groupId>com.pointblue.console</groupId>
                <artifactId>console-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- certificates and CSRs for the console's own TLS (the JDK has no public API to make them);
                 acme4j will use the same library -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <!-- tests only: an in-memory LDAP server (LDAPS, proxied authorization, custom extended operations)
                 standing in for eDirectory -->
            <dependency>
                <groupId>com.unboundid</groupId>
                <artifactId>unboundid-ldapsdk</artifactId>
                <version>7.0.2</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>junit</groupId>
                <artifactId>junit</artifactId>
                <version>4.13.2</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <systemPropertyVariables>
                            <!-- read once when the JDK's HTTP client loads: ServerTest sends a foreign Host header -->
                            <jdk.httpclient.allowRestrictedHeaders>host</jdk.httpclient.allowRestrictedHeaders>
                            <!-- tests never ask GitHub for the latest release on their own -->
                            <console.updateCheck>off</console.updateCheck>
                            <console.expiryCheck>off</console.expiryCheck>
                            <console.acmeCheck>off</console.acmeCheck>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
