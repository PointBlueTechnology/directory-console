<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pointblue.console</groupId>
        <artifactId>directory-console</artifactId>
        <version>0.3.1</version>
    </parent>

    <artifactId>console-server</artifactId>
    <name>console-server</name>
    <description>The Directory Console service: bootstrap, console TLS, trust store, configuration,
        audit, sign-in and the API.</description>

    <dependencies>
        <dependency>
            <groupId>com.pointblue.console</groupId>
            <artifactId>console-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pointblue.dirxml</groupId>
            <artifactId>dirxml-dev</artifactId>
        </dependency>
        <dependency>
            <groupId>com.novell.ldap</groupId>
            <artifactId>jldap</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pointblue.dirxml</groupId>
            <artifactId>dirxml-simulator</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
        </dependency>
        <dependency>
            <groupId>com.unboundid</groupId>
            <artifactId>unboundid-ldapsdk</artifactId>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
    </dependencies>


    <build>
        <finalName>console</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- the web UI, when it has been built (cd console-web && npm ci && npm run build) -->
            <resource>
                <directory>../console-web/dist</directory>
                <targetPath>web</targetPath>
            </resource>
        </resources>
        <plugins>
            <!-- a runnable jar: java -jar console.jar, its dependencies beside it in lib/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.pointblue.console.server.Main</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>runtime-lib</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
